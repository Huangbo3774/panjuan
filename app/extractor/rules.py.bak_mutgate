"""题型识别（PRD §5.1）：规则 + 启发式，不依赖大模型。

输入是 layout 层已经按阅读顺序排好的行（含列间距），不是原始 OCR 碎片。
这一点很关键：双栏卷必须先经过 columns.structure_page 归位，否则这里拿到的
行序就是跨栏穿插的，规则写得再好也切不对（见 docs/P0-真实样本.md §3.1）。

对 PRD 规则表的补充（真实二年级样本暴露的缺口）：
  · 空括号（）也是空位：拼音格、方框格在文本层里就渲染成（）或（  ），
    PRD 只写了「全角括号长度≥2」，这里放宽到允许括号内有 0~4 个空格/全角空格。
  · 圆圈数字 ①②③ 既可能是题号也可能是选项，按是否已处于选项段区分。
"""
from __future__ import annotations

import re
from typing import Any

# 大题标题：一、二、… + 关键词
SECTION_RE = re.compile(r"^([一二三四五六七八九十]{1,3})[、.．]\s*(.*)$")
# 关键词表只当"加分项"：真实二年级卷的大题名常常不带"题"字
#   实测：「二、选择。(每题3分，共15分)」「三、公园畅游指南」「四、解决问题」「一、填一填」
#   全部不在原关键词表里 → 整卷只认出一个大题 → 6 个大题的 1、2、3 挤在一起，
#   报出 14～20 个"假重号"。所以真正的判据是【序号连续递增】（见 extract 里 expect_sec_no）。
SECTION_KW = ("选择题", "单选题", "填空题", "判断题", "解答题", "问答题",
              "计算题", "应用题", "连线", "排序", "写话", "作文", "操作题",
              "选一选", "填一填", "算一算", "画一画", "数一数", "列式", "解决问题",
              "选择", "判断", "解答", "填空", "简算", "脱式", "口算")

# 题号：分隔符处理是这里最容易出错的地方，三种情况都实测踩过：
#   · 顿号「、」「．」后面通常没有空格（"1、用竖式计算。"）→ 用 \s*
#   · 半角「.」在中文 OCR 文本里也常常没有空格（"1.一共有("）→ 也必须允许 \s*，
#     否则整卷切不出题（实测扫描卷从 14 题掉到 2 题）。
#     防小数的办法不是要求空格，而是禁止「.」后紧跟数字：3.5 不当题号，3.一共有 当。
#   · 括号式（1）单独一支。
Q_NUM_RE = re.compile(
    r"^(?:(\d{1,3})[、．]\s*"          # 1、 2．
    r"|（(\d{1,3})）[、.]?\s*"          # （1） (2)、
    r"|(\d{1,3})\.(?!\d)\s*)(.*)$")    # 1. 但不能是 3.5
Q_CIRCLED_RE = re.compile(r"^([①-⑳])[.、．]?\s*(.*)$")
# 整行只剩一个数字（"3" / "3."）—— 扫描卷上"题号在图顶上、题干在图底下"时，
# OCR 会把题号单独切成一行，中间隔着一整张图（实测：第三单元练习题 第 4 天 第 3 题
# "3." 在 y=450，题干"观察图片，提出两个能用6×2解决的问题。"在 y=570）。
# 这种行不当题号，整道题就凭空消失，孩子卷面上直接少一题。
BARE_NUM_RE = re.compile(r"^(\d{1,2})\s*[.、．]?$")
# 行内小问 (1) (2)
SUBQ_RE = re.compile(r"^[（(](\d{1,2})[）)][、.．]?\s*")
# 选项 A. B、 C． A)
OPT_RE = re.compile(r"^([A-H])\s*[.、．)]\s*(.*)$")
# 空位：下划线 / 括号里一整串空白（空位就是"括号 + 一段留白"）
# ⚠️ 空白【不限长度】。旧版卡 1–4 个空格，而扫描件上的一道空位常被 OCR 读成
# 6–8 个空格（实测 E:\数学卷子\第三单元练习题.pdf 第 1 页：卷面 33 个空位，
# 卡 4 个空格时只数到 3 个）→ 做题页每道题只给一个输入框，
# 孩子没法按空位分别作答。括号里只要全是空白，就是空位，没有第二种解释。
# ⚠️ 括号【左右各允许半角或全角】：OCR 经常读成"（    )"这种混配的一对
#   （同一份卷实测有 5 个，只认成对写法就少算 5 个空位：28 ≠ 卷面 33）。
BLANK_RE = re.compile(r"(_{2,}|[＿]{2,}|[（(]\s*[）)])")
# 判断句特征
JUDGE_HINT = ("对的打", "正确的打", "错的打", "判断", "√", "×", "对的画", "正确的画")
# 英文大题（真实英文样本里 Section A 完全没被认出来，只会认中文序号）
SECTION_EN_RE = re.compile(r"^(Section|Part|Unit)\s+([A-D])\b[:：]?\s*(.*)$", re.I)
SECTION_EN_KW = ("choice", "fill", "blank", "judge", "answer", "reading",
                 "writing", "cloze", "comprehension", "calculation", "true")
CN_NUM = {"一": 1, "二": 2, "三": 3, "四": 4, "五": 5, "六": 6, "七": 7,
          "八": 8, "九": 9, "十": 10, "十一": 11, "十二": 12}


CN_NUM = {"一": 1, "二": 2, "三": 3, "四": 4, "五": 5, "六": 6, "七": 7,
          "八": 8, "九": 9, "十": 10, "十一": 11, "十二": 12}


def _cn2int(s: str) -> int | None:
    return CN_NUM.get(s)


# 教辅书常见分段：第1天 / 第2课时 / 第3单元 —— 每段各自从 1 重新编号。
# 不认这些分段，会把 8 天的题挤进同一大题，制造 29 个"假重号"（扫描卷实测）。
# ⚠️ 曾经在这里加过「标题后面剩余长度 ≤24 才算分段」的闸门，直接漏掉了真实行
#    "第2天   画校园路线图[课时2]            拍照秒批"（剩余 27 字）→ 整卷重号 20。
#    页眉页脚的水印是排版噪声，应该由 _clean_title() 去掉，而不是拿长度当判据。
SECTION_DAY_RE = re.compile(
    r"^(第\s*\d+\s*(?:天|课时|周|讲|单元)|第\s*[一二三四五六七八九十]{1,3}\s*(?:天|课时|周|讲))"
    r"[\s:：]*(.*)$")
# 「第三单元综合练习」「综合实践(一)达标练习」「整理和复习」这类没有序号的分段标题
SECTION_MISC_RE = re.compile(
    r"^.{0,20}?(综合练习|综合应用|达标练习|达标检测|单元测试|单元检测|回顾整理|整理和复习|总复习)[。]?$")

# 扫描 App 水印 / 页眉页脚 / 页码：这些一定不是题目内容。
# 真实样本里每一页都带「夸克扫描王 / 极速扫描，就是高效 / 拍照秒批 / 视频讲解」，
# 以及「综合实践(一)达标练习第2页(共4页) 158」「·38·」这类页脚。
NOISE_WORDS = ("夸克扫描王", "极速扫描", "扫描王", "拍照秒批", "秒批", "视频讲解",
               "祝频讲解", "现刻讲解", "就高效", "就是高效", "限时免费",
               "错题讲解", "在线批改", "AI批改")
# ⚠️ 页码两侧都得有分隔符（"·38·"「。26。」），不能写成 "^\d+[.。]?$"——
#    那样「2.」这种"题号后面内容全在图里"的真实题干会被当页码丢掉（实测命中）。
NOISE_PAGENO_RE = re.compile(r"^[·•。.]\s*\d{1,3}\s*[·•。]$|^\d{1,3}\s*[·•。]\s*\d{1,3}$")
NOISE_FOOT_RE = re.compile(r"第\s*\d+\s*页\s*[（(]?\s*共\s*\d+\s*页")
NOISE_BOOK_RE = re.compile(r"(天天练|教材解读|小学数学|小学语文|小学英语|年级上册|年级下册)")
NOISE_ANSWER_REF_RE = re.compile(r"答案\s*P\s*\d+")

# 教辅书的"栏目名"（不是题目，也不该进大题序列）
STAGE_KW = ("第一步", "第二步", "第三步", "第四步", "知识演练场", "智慧加油站",
            "基础过关", "能力提升", "拓展延伸", "素养提升", "过关检测", "考点集合")


def _is_noise(line: str) -> bool:
    s = line.strip()
    if not s:
        return True
    if NOISE_PAGENO_RE.match(s) or NOISE_FOOT_RE.search(s) or NOISE_ANSWER_REF_RE.search(s):
        return True
    if len(s) <= 24 and NOISE_BOOK_RE.search(s) and not BLANK_RE.search(s):
        return True
    rest = s.replace("，", " ").replace(",", " ")
    for w in NOISE_WORDS:
        rest = rest.replace(w, " ")
    return bool(NOISE_WORDS) and not rest.strip()


def is_furniture_text(line: str) -> bool:
    """这一行是【页面上印的家具】：页脚页码、扫描 app 的 logo、教辅书名行。

    裁图那边要拿它当一道硬墙 —— 最后一道题的区间一直延伸到页底，
    图和页脚/二维码之间只隔一行字，补洞合并会把它们缝成一张
    （实测：综合实践单元(1).pdf 书法馆路线图那张图，成品里连着"夸克扫描王"+二维码）。
    """
    s = (line or "").strip()
    if not s:
        return False
    if NOISE_PAGENO_RE.match(s) or NOISE_FOOT_RE.search(s) or NOISE_ANSWER_REF_RE.search(s):
        return True
    if len(s) <= 24 and NOISE_BOOK_RE.search(s):
        return True
    if any(w in s for w in NOISE_WORDS):
        return True
    # 教辅的【栏目横幅】（"第二步 练变式"、"知识演练场"、"能力提升"）：
    # 整块彩色底 + 反白字，被当成"配图"裁出来就是一张印着栏目名的废图
    # （真卷实测：第三单元练习题 第 3 页第 1 题的配图里挂着"第二步练变式"）。
    # ⚠️ 复用 _is_stage 那一份判据（短、且不带题号）——题干里出现"【能力提升】"
    #   不算栏目横幅，不能因为一个关键词就把整行当家具。
    return _is_stage(s)


def _is_stage(line: str) -> bool:
    s = line.strip()
    return len(s) <= 16 and not Q_NUM_RE.match(s) and any(k in s for k in STAGE_KW)


def _clean_title(s: str) -> str:
    """去掉行尾的水印和多余空格，只留标题本身。"""
    out = s
    for w in NOISE_WORDS:
        out = out.replace(w, " ")
    out = re.sub(r"\s{2,}", " ", out).strip(" :：-—")
    return out.strip()


def _is_section(line: str, expect_no: int | None = None) -> tuple[bool, str, str]:
    """这一行是不是大题/分段标题？

    expect_no 是【期望的下一个中文大题序号】。真实考卷的大题名五花八门
    （「一、填一填」「三、公园畅游指南」「四、解决问题」），靠关键词表永远补不全；
    而「序号比上一个大题 +1」这个结构判据几乎不会出错，所以两个判据取或。
    """
    s = line.strip()
    m = SECTION_RE.match(s)
    if m:
        no, rest = m.group(1), _clean_title(m.group(2) or "")
        n = _cn2int(no)
        kw = any(k in rest for k in SECTION_KW)
        # 用「不小于上一个大题序号」而不是「正好等于」：真实扫描卷会整行漏掉「二、」，
        # 严格递增会让后面的 三、四、 全部认不出（综合实践单元实测 6 个大题只认出 2 个）。
        # 护栏只有一条硬的：标题不会自带答题空位（"（ ）"「＿＿」）。
        # 长度闸门放宽到 60：真实大题名可以带一长句引入
        #   "六、随着无人驾驶技术的发展，无人配送车已投入使用。(共 12 分)"（31 字），
        #   旧版 30 字上限会把这道大题吞成"·续"。（≤24 那版直接把整卷压成 20 个假重号。）
        ordinal = (n is not None and expect_no is not None and n >= expect_no
                   and len(rest) <= 60 and not BLANK_RE.search(rest))
        if kw or ordinal:
            return True, no, rest
    m = SECTION_EN_RE.match(s)                    # 英文卷 Section A / Part B
    if m:
        # ⚠️ group(2) 是字母（A/B/C），标题正文在 group(3)；早先把 group(2) 当 rest
        #    去查关键词，等于永远查不到 → 英文卷的 Section 一个都没认出来。
        return any(k in (m.group(3) or "").lower() for k in SECTION_EN_KW), "", s
    m = SECTION_DAY_RE.match(s)
    if m:
        return True, "", _clean_title(s)
    if len(s) <= 24 and not Q_NUM_RE.match(s) and SECTION_MISC_RE.match(s):
        return True, "", _clean_title(s)
    return False, "", ""


def _parse_question_no(line: str, circled_as_no: bool = False) -> tuple[int | None, str]:
    """题号解析。

    ⚠️ 圆圈数字 ①②③ 的语义看上下文：
       · 选择题里它们是【选项】（"①东 ②南 ③西 ④北"）—— 当成题号会制造大量假重号；
       · 连线/排序题里它们是【条目】，要当题号。
       所以默认不当题号，只有大题目标题含"连线/排序"等关键词时才认（circled_as_no）。
    """
    s = line.strip()
    m = Q_NUM_RE.match(s)
    if m:
        num = m.group(1) or m.group(2) or m.group(3)
        return int(num), m.group(4)
    if circled_as_no:
        m = Q_CIRCLED_RE.match(s)
        if m:
            return ord(m.group(1)) - ord("①") + 1, m.group(2)
    return None, s


# 一道大题里的"（1）（2）（3）"小问。它们【不是独立的题】（题号、分值、批改都跟着大题走），
# 但必须【各占一行、各答各的空】—— 否则卷面上三问挤成一段，孩子不知道哪一空答哪一问
# （用户原话："一个题目里面有三个小题，非得挤在一个框子里，怎么分别作答呢？"）。
SUBQ_MARK_RE = re.compile(r"[（(]\s*(\d{1,2})\s*[）)]")


def split_subqs(text: str) -> list[dict[str, Any]]:
    """题干 → [{no, text, blanks}]；不够两个小问就返回 []（当普通题排）。

    ⚠️ 三条判据，每条挡一类误伤：
      · 标记必须是**括号里正好一个数字**——填空的空位写作"（   ）"，没有数字，
        所以 `（ ）` 永远不会被当成小问号（这条是最容易踩的，卷子上空位比小问多得多）；
      · 编号必须从 1 开始**严格递增**——"3×4=（12）"这种已经填了数的空、
        或者只出现一次"(2)"的杂散文本，都不会被拆；
      · 至少 2 段且每段非空——只有一问的题不配叫"小问"。
    """
    t = (text or "").strip()
    if not t:
        return []
    marks = [m for m in SUBQ_MARK_RE.finditer(t)]
    if len(marks) < 2:
        return []
    # 只保留"从 1 开始、每次 +1"的那串标记（后面的杂散括号一律不当小问号）
    keep: list = []
    want = 1
    for m in marks:
        try:
            n = int(m.group(1))
        except ValueError:
            continue
        if n == want:
            keep.append((n, m.start(), m.end()))
            want += 1
    if len(keep) < 2:
        return []
    out: list[dict[str, Any]] = []
    for i, (n, st, e) in enumerate(keep):
        end = keep[i + 1][1] if i + 1 < len(keep) else len(t)
        seg = t[e:end].strip()
        if not seg:
            return []
        item: dict[str, Any] = {"no": n, "text": seg, "blanks": len(BLANK_RE.findall(seg))}
        if i == 0 and st > 0:
            # 第一个小问之前还有正文（"看图填一填。（1）…"）→ 那是【引导语】，
            # 不是小问，也不能丢：单独放 lead，由排版先印它一行。
            item["lead"] = t[:st].strip()
        out.append(item)
    return out

def _bare_number_starts_question(line: str, last_no: int | None,
                                 cur_q: dict | None, numbered_in_sec: int) -> int | None:
    """整行只有一个数字 → 只有"正好接在上一题后面"时才算题号。

    ⚠️ 三条全中才算，每条挡一类误伤：
      · last_no 是数字且【正好差 1】—— 图里那些孤立的"3"（连线题的一项、算式余数、
        数轴刻度）不会刚好接在上一题号后面；
      · 上一题已经有 ≥4 个字的题干 —— 否则"1 2 3"这种连着排的数字会被切成三道空题；
      · 本大题至少已有一道带题号的题 —— 大题开头就冒出一个数字多半是别的东西。
    """
    if last_no is None or numbered_in_sec < 1:
        return None
    if cur_q is None or len(str(cur_q.get("text") or "").strip()) < 4:
        return None
    m = BARE_NUM_RE.match((line or "").strip())
    if not m:
        return None
    n = int(m.group(1))
    return n if n == last_no + 1 else None


def _norm_blank_runs(text: str) -> str:
    """把连续空位压成一个占位，返回 (文本, 空位数)。"""
    n = len(BLANK_RE.findall(text))
    return text, n


def extract(lines: list[str], title: str = "") -> dict[str, Any]:
    """行列表 → 题目结构。lines 必须是【已按阅读顺序排好】的行。"""
    sections: list[dict] = []
    cur_sec: dict | None = None
    cur_q: dict | None = None
    skipped: list[str] = []
    noise: list[str] = []
    markers: list[str] = []
    # 下一个中文大题序号（一=1）。真实卷偶尔 OCR 漏掉「二、」，所以只用来做"或"判据，
    # 命中后按识别到的序号续排，不做强制校验。
    expect_sec_no: int | None = 1

    def new_section(name: str, no: str = "") -> dict:
        nonlocal cur_sec, expect_sec_no
        cur_sec = {"name": (f"{no}、{name}".strip("、") if no else name), "questions": []}
        sections.append(cur_sec)
        if no:
            n = _cn2int(no)
            if n:
                expect_sec_no = n + 1
        return cur_sec

    def open_section(name: str, no: str = "") -> None:
        """开新大题。若上一个大题还没收到任何题（连续的标题行），就改名而不是空挂一节。"""
        if cur_sec is not None and not cur_sec["questions"] and (no or name):
            cur_sec["name"] = (f"{no}、{name}".strip("、") if no else name) or cur_sec["name"]
            if no:
                n = _cn2int(no)
                if n:
                    expect_sec_no = n + 1
            return
        new_section(name, no)

    def push_question(no: int | None, stem: str, sec: dict, form: str = "") -> dict:
        nonlocal cur_q
        q = {"q_no": no, "qtype": "essay", "text": stem.strip(),
             "options": [], "blanks": 0, "score": 1.0, "confidence": 0.5,
             # no_form 记下题号长什么样（"1." 还是"（1）"）。它决定后面遇到"（2）"
             # 时该并进来还是另起一题 —— 见下面"小问不另起一题"那条。
             "no_form": form, "source_lines": [stem]}
        sec["questions"].append(q)
        cur_q = q
        return q

    # 先把"一行含多题"的输入拆开（扫描卷 OCR 常把选项和下一题号并进同一行）
    expanded: list[str] = []
    for raw in lines:
        expanded += _split_multi_question_line(raw) if raw and raw.strip() else []

    answer_key: list[str] = []
    last_no: int | None = None          # 当前大题里最后见到的题号（用于识别"重新编号"）
    numbered_in_sec = 0
    seen_numbered = False               # 整卷是否已出现带题号的题（卷首信息区的边界）

    for raw in expanded:
        line = (raw or "").strip()
        if not line:
            continue
        if _is_noise(line):
            noise.append(line)
            continue
        if _is_stage(line):
            markers.append(line)
            continue
        # 进入答案区后全部收下，不再切题（答案区是批改的输入，不是题目）
        if answer_key or _is_answer_key(line):
            answer_key.append(line)
            continue
        is_sec, sec_no, sec_rest = _is_section(line, expect_sec_no)
        if is_sec:
            open_section(sec_rest, sec_no)
            cur_q = None
            last_no = None
            numbered_in_sec = 0
            continue

        if _looks_like_header(line) and not seen_numbered:
            # 卷首信息区（班级/姓名/满分/时间）不是题目。
            # ⚠️ 判据是【还没出现任何带题号的题】，不是"还没建大题"：
            #    真实卷第一行往往是卷名（"第三单元 过关练习"），它先建了大题，
            #    于是"班级＿＿ 姓名＿＿ 满分 100"就因为"已有大题"被当成题干并进去了。
            skipped.append(line)
            continue
        if cur_sec is None:
            # ⚠️ 不能"没有大题标题就整行丢弃"：真实考卷常没有规范的「一、选择题」，
            #    或 OCR 漏读标题，那样会把整卷切成 0 题（实测 L2 卷命中）。
            new_section("")

        opt = OPT_RE.match(line)
        toks = _opt_tokens(line) or _circled_options(line)
        if toks and cur_q is not None:
            cur_q["options"].extend(toks)
            cur_q["source_lines"].append(line)
            continue

        no, rest = _parse_question_no(line, circled_as_no=_section_wants_circled(cur_sec.get("name", "")))
        if no is not None and cur_q is not None and cur_q.get("no_form") == "plain" \
                and SUBQ_RE.match(line) and len(str(cur_q.get("text") or "").strip()) >= 4:
            # 【小问不另起一题】"1. 先把词语补充完整，再完成练习。" 下面的
            # "（1）以上词语都可以用来描写…"、"（2）选词填空…" 是同一道大题里的小问。
            # 当成新题就会出现【两道第 1 题】（审计器报"重号"，卷面上多一道假题）。
            # ⚠️ 只有【上一题是"1."这种平排题号】时才并：整段都用（1）（2）（3）编号的卷
            #    （"选一选。（1）…（2）…"）它们就是平级的题目，并起来反而少题。
            cur_q["text"] = (cur_q["text"] + " " + rest).strip()
            cur_q["source_lines"].append(line)
            _split_inline_options(cur_q)
            continue
        if no is not None and not _looks_like_answer_only(rest):
            # 题号在本大题内【倒退】→ 这是一段新的编号序列（第N天/新一关/漏认的大题标题）。
            # 实测：教辅书每页从 1 重新编号，标题行被水印挤散时，倒退就是唯一的分段信号。
            if last_no is not None and no < last_no and numbered_in_sec >= 2:
                prev = cur_sec.get("name", "") if cur_sec else ""
                open_section(f"{prev}·续" if prev else "")
                cur_q = None
            push_question(no, rest, cur_sec,
                          "plain" if SUBQ_RE.match(line) is None else "paren")
            _split_inline_options(cur_q)
            last_no = no
            numbered_in_sec += 1
            seen_numbered = True
            continue

        bare = _bare_number_starts_question(line, last_no, cur_q, numbered_in_sec)
        if bare is not None:
            # 题号单独成行（题干在图底下）→ 开一道新题，题干等后面的行补进来。
            # 不认的话这道题就凭空消失（实测：第三单元练习题 第 4 天整卷少第 3 题）。
            push_question(bare, "", cur_sec, "plain")
            last_no = bare
            numbered_in_sec += 1
            seen_numbered = True
            continue

        if cur_q is None:
            push_question(None, line, cur_sec)
            continue

        # 续行：并入题干，再尝试从题干里拆出选项（选项行已在上面处理，这里只会拆到
        # "题干 + 选项写在同一行"的情况）
        cur_q["text"] = (cur_q["text"] + " " + line).strip()
        cur_q["source_lines"].append(line)
        _split_inline_options(cur_q)

    # 兜底：一道题都没切出来时，把整页当一道大题，绝不返回空
    if not any(s["questions"] for s in sections):
        sec = {"name": "", "questions": []}
        for l in lines:
            if l and l.strip() and not _is_noise(l):
                sec["questions"].append({"q_no": None, "qtype": "essay",
                                         "text": l.strip(), "options": [], "blanks": 0,
                                         "score": 1.0, "confidence": 0.2,
                                         "fallback": True,
                                         "source_lines": [l]})
        sections = [sec] if sec["questions"] else []

    # 卷名提升：真实卷的第一行常常就是卷名（"第三单元 过关练习"），
    # 它没有题号、没有空位、很短，后面才出现正经带题号的题。
    # 不提升的话它会变成第 1 道"填空题"，孩子第一屏看到的就是垃圾题。
    if sections and sections[0]["questions"]:
        q0 = sections[0]["questions"][0]
        rest_all = [q for s in sections for q in s["questions"]]
        later_numbered = any(q.get("q_no") is not None for q in rest_all[1:])
        # ⚠️ 这里不能用 q0["blanks"]：_classify 还没跑，blanks 恒为 0，
        #    等于一条永远成立的假判据（"尺永远绿"那种坑）。直接查原文有没有空位。
        if (q0.get("q_no") is None and not q0.get("options")
                and not BLANK_RE.search(q0["text"])
                and len(q0["text"]) <= 30 and later_numbered):
            if not title:
                title = q0["text"]
            skipped.append(q0["text"])
            sections[0]["questions"].pop(0)
            if not sections[0]["questions"]:
                sections.pop(0)

    for s in sections:
        # 中文卷每个大题都从 1 重新编号，所以"重号"必须【在大题内部】判定。
        # 全文档查重号会把正常结构误判成异常（实测扫描卷 8 个假重号）。
        local = 0
        for q in s["questions"]:
            if q.get("fallback"):
                q["needs_review"] = True      # 兜底题置信度必须保持极低，不再被重新分类抬高
                continue
            _classify(q, s.get("name", ""))
            if q["q_no"] is None:
                local += 1
                q["auto_no"] = local
            else:
                q["auto_no"] = q["q_no"]
    total = sum(len(s["questions"]) for s in sections)
    return {"title": title, "sections": sections, "questions": total,
            "skipped_header_lines": skipped, "answer_key_lines": answer_key,
            "dropped_noise": noise, "stage_markers": markers}


def _split_multi_question_line(line: str) -> list[str]:
    """一行里含多道题时再切一刀（扫描卷常见：选项与下一题号被 OCR 并成一行）。
    只在切出的每段都能独立成立时才切，避免把 "3.5 与 4.2" 这类内容切碎。"""
    marks = list(re.finditer(r"(?<![.\d])(\d{1,2})[、．.](?!\d)\s*", line))
    if len(marks) < 2:
        return [line]
    parts: list[str] = []
    head = line[: marks[0].start()]
    if head.strip():
        parts.append(head.strip())
    for i, m in enumerate(marks):
        end = marks[i + 1].start() if i + 1 < len(marks) else len(line)
        seg = line[m.start():end].strip()
        if seg:
            parts.append(seg)
    return parts if len(parts) >= 2 else [line]


HEADER_HINTS = ("班级", "姓名", "得分", "满分", "时间：", "时长", "评分",
                "第 1 页", "第1页", "共 4 页", "共4页", "答案", "达标练习", "模拟卷", "单元测试",
                # 教辅的牌子/版本行。真实卷：横版那张第一行是"测评卷  5·3天天练小学数学
                # 二年级上册BSD"，不当表头就会被切成"第 1 题"，于是它旁边那坨
                # logo＋"时间/满分/评价"表格被当成第 1 题的配图裁下来
                # （审计器报的那条"串题"：一张 368×166 的框盖住了第 2 题的文字）。
                "测评卷", "天天练", "课时练", "单元测评", "年级上册", "年级下册",
                "BS版", "BSD", "RJ版", "PEP", "人教版", "北师", "苏教版", "外研版")


def _looks_like_header(line: str) -> bool:
    """判断是不是卷首信息行（只在还没进入任何大题时使用）。"""
    s = line.strip()
    if len(s) > 40:
        return False                       # 长行更可能是题干，不当表头
    # ⚠️ 带题号的行永远不是卷首信息行：真实题干里会出现"答案/得分"这些词
    #    （"1. 看图填方向，把答案写在括号里。"），而这条判据跑在【第一道带题号的题】
    #    之前 —— 不排掉的话，卷子的第 1 题会被当表头整行丢掉（孩子看到的就是少一道题）。
    if Q_NUM_RE.match(s) or Q_CIRCLED_RE.match(s):
        return False
    return any(h in s for h in HEADER_HINTS)


CIRCLED_ITEM_SECTIONS = ("连线", "排序", "搭配", "连一连", "排一排")


def _section_wants_circled(section_name: str) -> bool:
    """连线/排序题里 ①②③ 是条目（当题号）；选择题里它们是选项（不当题号）。"""
    return any(k in (section_name or "") for k in CIRCLED_ITEM_SECTIONS)


CIRCLED_OPT_RE = re.compile(r"[①-⑳]")


def _circled_options(line: str) -> list[str]:
    """圆圈选项行：①东 ②南 ③西 ④北 —— 中文卷的选择题选项常用圆圈。
    要求一行内至少 2 个圆圈且开头就是圆圈，否则可能是正文里引用了 ①。"""
    s = (line or "").strip()
    if not s or not CIRCLED_OPT_RE.match(s):
        return []
    parts = [p.strip() for p in re.split(r"(?=[①-⑳])", s) if p.strip()]
    return parts if len(parts) >= 2 else []


# 答案区标记：一旦命中，后面的内容归入 answer_key，不再当题目切分。
# 实测：英文样本的 "参考答案：1.B 2.A 3.C 4.uniform" 被切成 7 道假题。
ANSWER_KEY_RE = re.compile(
    r"^\s*(参考答案|答案|答案页|答案P\d|参考解答|解答区"
    r"|(?:reference\s+)?answers?\s*[:：]?|answer\s*key)", re.I)
# 纯字母/纯数字的短答案（"B"、"A"、"√"、"×"）不是题干
ANSWER_TOKEN_RE = re.compile(r"^[A-Ha-h√×对错]\.?$")


def _is_answer_key(line: str) -> bool:
    return bool(ANSWER_KEY_RE.match(line.strip()))


def _looks_like_answer_only(rest: str) -> bool:
    """题号后面只剩一个字母/符号 → 这是答案行，不是题目。"""
    s = (rest or "").strip()
    return bool(s) and len(s) <= 2 and bool(ANSWER_TOKEN_RE.match(s))


def _opt_tokens(line: str) -> list[str]:
    """把一行切成若干「选项」片段。返回 [] 表示这行不是选项行。

    必须先数个数：整行以 "A." 开头时 OPT_RE 会匹配成功，
    若直接当成单个选项，"A. 4乘7  B. 4乘以7  C. 7乘4  D. 四七二十八" 会变成一个选项
    （实测两个失败用例同源于此）。
    """
    s = (line or "").replace("\u3000", " ").strip()
    if not OPT_RE.match(s):
        return []
    # 用前瞻切分而非「要求前面有空白」：真实文本里 "A、6 B、5   C、4" 的 B 前面可能没空格，
    # 要求 \s+ 会把它整行当成一个选项（实测 L2 卷命中）。
    # 但必须排除 "A. apple banana" 里单词首字母被当选项的情况 → 只认紧跟分隔符的 A-H。
    parts = [p.strip() for p in re.split(r"(?=[A-H]\s*[.、．)])", s) if p.strip()]
    return [p for p in parts if OPT_RE.match(p)]


def _split_inline_options(q: dict) -> bool:
    """题干里塞了多组选项时拆出来。"""
    found = _opt_tokens(q.get("text") or "")
    if len(found) < 2:
        return False
    head = [p.strip() for p in re.split(r"(?=[A-H]\s*[.、．)])", q["text"].replace("\u3000", " "))
            if p.strip() and not OPT_RE.match(p.strip())]
    q["options"] = (q.get("options") or []) + found
    q["text"] = " ".join(head).strip()
    return True


def repair_blanks(text: str) -> tuple[str, int]:
    """把 OCR 读残的填空括号补成完整的一对，返回 (补好的文本, 补了几处)。

    真实卷（综合实践单元.pdf 第 1 页 一、填空 第 1 题）原文是
    "它的特点是一端指（ ），一端指（ ）。"
    OCR 只读出 "…一端指 ),一端指(" —— 空位的另一半是几个像素，直接丢了。
    括号不配对的卷子是**做不了**的：孩子看不出该往哪儿写，家长也分不清
    "卷子本来就这样"还是"系统漏了"。

    两种残法分别补：
      ① 前面没有配对开括号的"）"，且它前面紧邻是汉字 → 这是一个空位的右半，
         补成"（ ）"。为什么要求紧邻是汉字：选项标号"A）"、序号"（1）"、
         算式"3:4=（ ）：12" 都不满足，不会被乱改。
      ② 整句以未配对的"（"收尾 → 末尾补"    ）"。最多补 3 个，
         句子中间的瑕疵不该越补越长，读丢的行尾才是真问题。
    """
    t = str(text or "")
    fixed = 0
    depth = 0
    out: list[str] = []
    for ch in t:
        if ch in "（(":
            depth += 1
            out.append(ch)
        elif ch in "）)":
            if depth > 0:
                depth -= 1
                out.append(ch)
            elif out and re.match(r"[\u4e00-\u9fff]", ("".join(out)).rstrip()[-1:] or " "):
                out.append("（ ）")           # 空位的右半被读丢，补成完整一对
                fixed += 1
            else:
                out.append(ch)
        else:
            out.append(ch)
    t2 = "".join(out).rstrip()
    if 0 < depth <= 3 and re.search(r"[（(]\s*$", t2):
        t2 += "    ）" * depth
        fixed += depth
    return (t2 if fixed else str(text or "")), fixed


def _classify(q: dict, section_hint: str = "") -> None:
    """题型判定优先级（PRD §5.1）：选项 → choice/judge；空位 → fill；长题干 → essay

    ⚠️ 判"判断题"不能看选项里有没有「对/错」二字 —— 选择题的选项常含"对"
       （"B. 4乘以7"、"4×7 读作"），实测会把选择题误判成判断题。
       只有「恰好两个选项且都是对/错类词」或「题干/大题名有判断信号」才算 judge。
    """
    text = q["text"]
    # 先补 OCR 读残的括号，再数空位：否则"后面是（"会被当成没有空位的题
    text, fixed = repair_blanks(text)
    if fixed:
        q["text"] = text
        q["blanks_closed"] = fixed
    # 补完还是不配对（"…后面是（ 夜晚，…"——缺的那个"）"在句子中间，位置猜不出来）：
    # 不硬编，标成待人工校对。校对页会挂"待校对"角标，家长一眼知道哪题要看书原图。
    if (text.count("（") + text.count("(")) != (text.count("）") + text.count(")")):
        q["needs_review"] = True
        q["review_note"] = "括号不配对（OCR 读丢了空位的另一半），请对照原卷补全"
    _, blanks = _norm_blank_runs(text)
    q["blanks"] = blanks
    opts = [o.strip() for o in q["options"]]
    judge_signal = any(k in text for k in JUDGE_HINT) or any(k in section_hint for k in JUDGE_HINT)
    yes_no_pair = len(opts) == 2 and all(
        re.fullmatch(r"[A-H]\s*[.、．)]?\s*(对|错|√|×|T|F|正确|错误)\.?", o, re.I) for o in opts)
    conf = 0.5
    if opts:
        # 只有「两个对/错选项」才判 judge。不能因为大题名里有"判断"二字就把带 4 个选项的
        # 题目也判成 judge —— 实测 "一、选择题" + 选项含"4乘以7"的"对"字会误判。
        q["qtype"] = "judge" if (yes_no_pair or (judge_signal and len(opts) <= 2)) else "choice"
        conf = 0.9 if len(opts) >= 2 else 0.6
    elif judge_signal:
        q["qtype"] = "judge"
        conf = 0.8 if any(k in section_hint for k in JUDGE_HINT) else 0.7
    elif blanks:
        q["qtype"] = "fill"
        conf = 0.85
    else:
        # 无选项、无空位、非判断 → 问答/解答类。
        # ⚠️ 不要因为"没证据"就一律压到 0.6 从而 73% 的题都标待校对（真实扫描卷实测）：
        #   一句够长且以句末标点收尾的题干，切分本身是完整的，置信度应过 0.7 线。
        #   真正该标待校对的是"短残句"——多半是 OCR 断行或图形里的碎片。
        if len(text) >= 20 and re.search(r"[。？！?!:：]$", text):
            q["qtype"] = "essay"
            conf = 0.8
        else:
            q["qtype"] = "essay" if len(text) >= 12 else "unknown"
            conf = 0.6 if len(text) >= 12 else 0.3
    q["confidence"] = round(conf, 2)
    # ⚠️ 不能直接赋值：上面已经因为"括号不配对"标过待校对的，会被置信度这一行冲掉，
    # 于是校对页看不到提醒、家长拿着残缺题干让孩子做——正是用户骂的"题做不了"。
    q["needs_review"] = q["confidence"] < 0.7 or bool(q.get("review_note"))


def flatten_questions(res: dict[str, Any]) -> list[dict]:
    out = []
    for s in res["sections"]:
        for q in s["questions"]:
            out.append({**q, "section": s["name"]})
    return out
